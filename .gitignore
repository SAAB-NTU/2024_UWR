install/
logs/
build/
bin/
lib/
msg_gen/
srv_gen/
msg/*Action.msg
msg/*ActionFeedback.msg
msg/*ActionGoal.msg
msg/*ActionResult.msg
msg/*Feedback.msg
msg/*Goal.msg
msg/*Result.msg
msg/_*.py
build_isolated/
devel_isolated/

# Generated by dynamic reconfigure
*.cfgc
/cfg/cpp/
/cfg/*.py

# Ignore generated docs
*.dox
*.wikidoc

# eclipse stuff
.project
.cproject

# qcreator stuff
CMakeLists.txt.user

srv/_*.py
*.pcd
*.pyc
qtcreator-*
*.user

/planning/cfg
/planning/docs
/planning/src

*~

# Emacs
.#*

# Catkin custom files
CATKIN_IGNORE

# pixi / colcon
.pixi/
build/
install/
log/

# Vendored Xsens SDK source must be tracked (the generic lib/ rule above hid it);
# its build outputs are not.
!src/xsens_mti_ros2_driver/lib/
src/xsens_mti_ros2_driver/lib/**/*.o
src/xsens_mti_ros2_driver/lib/**/*.a
src/xsens_mti_ros2_driver/lib/**/*.d
src/xsens_mti_ros2_driver/lib/**/*.d.tmp

# kf_3dof output bags (launch_3dof.py default)
kf_runs/

# MCAP copies made by scripts/bag_to_mcap.sh (regenerate from the .bag)
*.mcap/

# Per-machine editor settings (contain local paths)
.vscode/settings.json
