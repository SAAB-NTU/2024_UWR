<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- helper: the same gaussian noise on x, y, z -->
  <xacro:macro name="noise_xyz" params="stddev">
    <x><noise type="gaussian"><mean>0</mean><stddev>${stddev}</stddev></noise></x>
    <y><noise type="gaussian"><mean>0</mean><stddev>${stddev}</stddev></noise></y>
    <z><noise type="gaussian"><mean>0</mean><stddev>${stddev}</stddev></noise></z>
  </xacro:macro>

  <xacro:macro name="mti_imu" params="parent *origin name:=imu rate:=100
                                      gyro_std:=0.0012 accel_std:=0.006">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="0.06 0.04 0.02"/>
        </geometry>
      </visual>
      <xacro:box_inertia m="0.05" x="0.06" y="0.04" z="0.02"/>
    </link>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="imu">
        <topic>${name}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <update_rate>${rate}</update_rate>
        <always_on>true</always_on>
        <imu>
          <orientation_reference_frame>
            <localization>ENU</localization>
          </orientation_reference_frame>
          <angular_velocity><xacro:noise_xyz stddev="${gyro_std}"/></angular_velocity>
          <linear_acceleration><xacro:noise_xyz stddev="${accel_std}"/></linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
