<?xml version="1.0"?>
<sdf version="1.10">
  <world name="tank">
    <scene>

      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- core: physics, GUI interaction, sending the scene to the GUI -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- sensors: Sensors runs rendering sensors (your gpu_lidar sonars); Imu runs IMUs -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- water below z=0, air above -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="tank">
      <static>true</static>
      <link name="walls">

        <collision name="floor_col">
          <pose>0 0 -2.05 0 0 0</pose>
          <geometry><box><size>5.2 10.2 0.1</size></box></geometry>
        </collision>
        <visual name="floor_vis">
          <pose>0 0 -2.05 0 0 0</pose>
          <geometry><box><size>5.2 10.2 0.1</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

        <collision name="wall_px_col">
          <pose>2.55 0 -0.75 0 0 0</pose>
          <geometry><box><size>0.1 10.2 2.5</size></box></geometry>
        </collision>
        <visual name="wall_px_vis">
          <pose>2.55 0 -0.75 0 0 0</pose>
          <geometry><box><size>0.1 10.2 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

        <collision name="wall_nx_col">
          <pose>-2.55 0 -0.75 0 0 0</pose>
          <geometry><box><size>0.1 10.2 2.5</size></box></geometry>
        </collision>
        <visual name="wall_nx_vis">
          <pose>-2.55 0 -0.75 0 0 0</pose>
          <geometry><box><size>0.1 10.2 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

        <collision name="wall_py_col">
          <pose>0 5.05 -0.75 0 0 0</pose>
          <geometry><box><size>5.2 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="wall_py_vis">
          <pose>0 5.05 -0.75 0 0 0</pose>
          <geometry><box><size>5.2 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

        <collision name="wall_ny_col">
          <pose>0 -5.05 -0.75 0 0 0</pose>
          <geometry><box><size>5.2 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="wall_ny_vis">
          <pose>0 -5.05 -0.75 0 0 0</pose>
          <geometry><box><size>5.2 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>