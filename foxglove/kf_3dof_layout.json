  "globalVariables": {},
  "userNodes": {
    "kf-sonar-m": {
      "name": "sonar_mm_to_m",
      "sourceCode": "// SONAR_raw distances are in mm; convert to m to plot next to Pose.\nimport { Input } from \"./types\";\n\ntype Output = { distance_1: number; distance_2: number; distance_3: number };\n\nexport const inputs = [\"SONAR_raw\"];\nexport const output = \"/studio_script/sonar_m\";\n\nexport default function script(event: Input<\"SONAR_raw\">): Output {\n  const m = event.message;\n  return {\n    distance_1: m.distance_1 / 1000,\n    distance_2: m.distance_2 / 1000,\n    distance_3: m.distance_3 / 1000,\n  };\n}\n"
    },
    "kf-path": {
      "name": "kf_path",
      "sourceCode": "// KF estimate (Pose) accumulated into a trail in the \"world\" frame for the 3D panel.\nimport { Input, Message } from \"./types\";\n\ntype Output = Message<\"foxglove.PosesInFrame\">;\n\nexport const inputs = [\"Pose\"];\nexport const output = \"/studio_script/kf_path\";\n\nconst MAX_POSES = 20000;\nlet poses: Output[\"poses\"] = [];\nlet lastNs = -1;\n\nfunction append(t: { sec: number; nsec: number }, x: number, y: number, z: number): Output {\n  const ns = t.sec * 1e9 + t.nsec;\n  if (ns < lastNs) {\n    poses = []; // seeked backwards: restart the trail\n  }\n  lastNs = ns;\n  poses.push({ position: { x, y, z }, orientation: { x: 0, y: 0, z: 0, w: 1 } });\n  if (poses.length > MAX_POSES) {\n    poses.shift();\n  }\n  return { timestamp: t, frame_id: \"world\", poses: poses.slice() };\n}\n\nexport default function script(event: Input<\"Pose\">): Output {\n  const p = event.message.pose.position;\n  return append(event.receiveTime, p.x, p.y, p.z);\n}\n"
    },
    "kf-pose": {
      "name": "kf_pose",
      "sourceCode": "// Current KF pose in the \"world\" frame (arrow in the 3D panel).\n// Orientation is the IMU attitude logged by kf_3dof; the KF itself does not estimate it.\nimport { Input, Message } from \"./types\";\n\ntype Output = Message<\"foxglove.PoseInFrame\">;\n\nexport const inputs = [\"Pose\"];\nexport const output = \"/studio_script/kf_pose\";\n\nexport default function script(event: Input<\"Pose\">): Output {\n  const p = event.message.pose;\n  return {\n    timestamp: event.receiveTime,\n    frame_id: \"world\",\n    pose: {\n      position: { x: p.position.x, y: p.position.y, z: p.position.z },\n      orientation: { x: p.orientation.x, y: p.orientation.y, z: p.orientation.z, w: p.orientation.w },\n    },\n  };\n}\n"
    },
    "kf-sonar-path": {
      "name": "sonar_path",
      "sourceCode": "// Raw sonar ranges (mm) as a position trail in m, same axes as the KF state.\nimport { Input, Message } from \"./types\";\n\ntype Output = Message<\"foxglove.PosesInFrame\">;\n\nexport const inputs = [\"SONAR_raw\"];\nexport const output = \"/studio_script/sonar_path\";\n\nconst MAX_POSES = 20000;\nlet poses: Output[\"poses\"] = [];\nlet lastNs = -1;\n\nfunction append(t: { sec: number; nsec: number }, x: number, y: number, z: number): Output {\n  const ns = t.sec * 1e9 + t.nsec;\n  if (ns < lastNs) {\n    poses = []; // seeked backwards: restart the trail\n  }\n  lastNs = ns;\n  poses.push({ position: { x, y, z }, orientation: { x: 0, y: 0, z: 0, w: 1 } });\n  if (poses.length > MAX_POSES) {\n    poses.shift();\n  }\n  return { timestamp: t, frame_id: \"world\", poses: poses.slice() };\n}\n\nexport default function script(event: Input<\"SONAR_raw\">): Output {\n  const m = event.message;\n  return append(event.receiveTime, m.distance_1 / 1000, m.distance_2 / 1000, m.distance_3 / 1000);\n}\n"
    }
  },
  "playbackConfig": {
    "speed": 1
  },
  "layout": "Tab!kfmain"
